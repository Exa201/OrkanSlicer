+interface OrcaMobileBridge {
+    beginDownload(fileName: string): void;
+    writeData(base64Chunk: string): void;
+    finishDownload(): void;
+    failDownload(message: string): void;
+}
+
+declare global {
+    interface Window {
+        OrcaMobile?: OrcaMobileBridge;
+    }
+}
+
+async function writeBlobToOrcaMobile(fileName: string, blob: Blob) {
+    const bridge = window.OrcaMobile;
+    if (!bridge) return false;
+
+    try {
+        bridge.beginDownload(fileName);
+        const bytes = new Uint8Array(await blob.arrayBuffer());
+        // Keep JavaScript strings and WebView bridge messages small on large 3MF exports.
+        const chunkSize = 48 * 1024;
+        for (let offset = 0; offset < bytes.length; offset += chunkSize) {
+            const chunk = bytes.subarray(offset, Math.min(offset + chunkSize, bytes.length));
+            let binary = '';
+            for (let index = 0; index < chunk.length; index += 8192) {
+                binary += String.fromCharCode(...chunk.subarray(index, index + 8192));
+            }
+            bridge.writeData(btoa(binary));
+        }
+        bridge.finishDownload();
+        return true;
+    } catch (error) {
+        bridge.failDownload(error instanceof Error ? error.message : String(error));
+        throw error;
+    }
+}
